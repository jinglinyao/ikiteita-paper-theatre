# ---------------------------------------------------------------- not ours to publish
# the song (Aimyon, "Ikiteitanda yo na") and anything rendered with it
/audio/
/deliver/
/publish/
# the lyrics and their translation: supply your own (format: docs/字幕_待填.json)
/docs/字幕.json
# working files, downloads, review notes, intermediate renders
/work/

# animation clips converted from Mixamo (Adobe's terms do not allow redistributing them); not used by the film
/unity/Assets/MV/Data/Clips/
/unity/Assets/MV/Data/Clips.meta
# lip-sync track of another song; not used by the film
/unity/Assets/MV/Data/lipsync_24_47.json
/unity/Assets/MV/Data/lipsync_24_47.json.meta
# the look-development scene and its character; not used by the film
/unity/Assets/Scenes/Look.unity
/unity/Assets/Scenes/Look.unity.meta
/unity/Assets/MV/Characters/jinglin_ps2.vrm
/unity/Assets/MV/Characters/jinglin_ps2.vrm.meta
